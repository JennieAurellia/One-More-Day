[node name="Text" type="Label" parent="Content/Margin1/Control/Page2/VBox2" unique_id=731296761]
custom_minimum_size = Vector2(440, 0)
layout_mode = 2
theme_override_colors/font_color = Color(0, 0, 0, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 1
theme_override_font_sizes/font_size = 24
text = "Maya has been checking on me a lot lately.

She keeps asking where I am, what I'm doing, when Adrian will be home, and what we're planning to do. At first, I thought she was just being her usual self, but lately it feels a little different.

She somehow knows things about my day that I don't remember telling her. Maybe I'm just forgetting things, but it's starting to feel a little strange.

I don't want to think too much about it. She's my best friend, after all. Maybe I'm just overthinking everything."
horizontal_alignment = 3
autowrap_mode = 3

