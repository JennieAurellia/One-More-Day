[node name="Text" type="Label" parent="Content/Margin1/Control/Page3/VBox1" unique_id=795458612]
custom_minimum_size = Vector2(440, 0)
layout_mode = 2
theme_override_colors/font_color = Color(0, 0, 0, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 1
theme_override_font_sizes/font_size = 24
text = "I think something is wrong with Maya.

I've been trying to ignore this feeling, but I can't anymore. She seems to be paying way too much attention to me and Adrian. She always wants to know where we are, what we're doing, and whether we're going somewhere together.

Today, she asked me again about our plans. I don't know why, but the way she asked made me uncomfortable.

Maybe there's a reason she's acting this way. I just wish I knew what it was.
I don't want to accuse my best friend of something without knowing the truth. But if this keeps happening, I think I need to talk to her about it."
horizontal_alignment = 3
autowrap_mode = 3

