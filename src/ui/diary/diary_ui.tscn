theme_override_colors/font_color = Color(0, 0, 0, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 1
theme_override_font_sizes/font_size = 24
text = "Maya came over today. We spent the afternoon talking about random things, just like we used to. It's always nice having her around. We've been friends for so long that sometimes I feel like she knows me better than anyone else.

She gave me a cute little plushie today, too. She said she saw it and immediately thought of me. She's always been thoughtful like that.

I really hope we can spend more time together. I miss the days when it was just the two of us, hanging out without having to worry about anything."
horizontal_alignment = 3
autowrap_mode = 3

